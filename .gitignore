# Secrets — keep .env.example (no real keys) committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Per-session resume files (uploads, previews, generated DOCX/PDF). The app
# deletes these itself when a user leaves; they must never be committed.
temp_*/
# Left behind by older versions of the app
output/
data/

# Resumes or JDs dropped into the project root for testing — real personal data
/*.pdf
/*.docx
/*.doc
/*.txt
!/requirements*.txt

# Logs
*.log

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
