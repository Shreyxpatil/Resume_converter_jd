# Required — Google Gemini is the primary AI provider for extraction/editing.
GEMINI_API_KEY=

# Optional — Groq is used as a fallback when every Gemini model fails
# (quota exhausted, deprecated model, network issue). Either name works.
GROQ_API=
# GROK_API=

# Optional — defaults shown.
# PORT=8000
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# MAX_UPLOAD_MB=15
# JOB_TTL_SECONDS=3600   # idle time before an abandoned session's files are deleted
# LOG_LEVEL=INFO

# Optional — only needed if PDF export can't find LibreOffice on PATH.
# SOFFICE_PATH=/path/to/soffice
